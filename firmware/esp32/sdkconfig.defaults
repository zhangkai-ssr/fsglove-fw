# FSGlove v2 ESP32 默认配置（首次 build 时写入 sdkconfig，可被 menuconfig 覆盖）

# --- 主任务栈：app_main 含网络/日志，调大避免溢出 ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# --- FreeRTOS tick 100Hz，时延与开销折中 ---
CONFIG_FREERTOS_HZ=1000

# --- UART：使用中断驱动的 ISR（默认），高波特率下保证不丢字节 ---
# 3Mbps 需要较快的 RX 处理，环形缓冲在 fsg_config.h 中设置

# --- lwip：UDP 低延迟回传，适度调大发送缓冲 ---
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCP_MSS=1436

# --- Wi-Fi：动态缓冲，足够吞吐 ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# --- 日志级别 INFO ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
